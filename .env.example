# 本番用。値は Vercel の Environment Variables に設定します。
# Upstash Redis を Vercel Storage から接続すると自動設定されます。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Blob（public）をプロジェクトに接続。
BLOB_READ_WRITE_TOKEN=
# 操作画面用の、12文字以上の長く推測されにくいパスワード。
ADMIN_PASSWORD=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" で生成
SESSION_SECRET=
# 本番とプレビューには別の Redis / 名前空間を使ってください。
DATA_NAMESPACE=sports-production
